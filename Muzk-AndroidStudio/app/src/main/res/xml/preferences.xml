<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:layout="@layout/pref_category"
        app:title="@string/pref_cat_look">
        <com.muzk.app.ui.settings.PalettePreference
            app:defaultValue="muzk"
            app:key="palette"
            app:title="@string/pref_palette"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:layout="@layout/pref_category"
        app:title="@string/pref_cat_audio">
        <Preference
            app:icon="@drawable/ic_equalizer"
            app:key="eq_system"
            app:summary="@string/pref_eq_system_summary"
            app:title="@string/pref_eq_system"/>
        <Preference
            app:icon="@drawable/ic_equalizer"
            app:key="eq_app"
            app:summary="@string/pref_eq_app_summary"
            app:title="@string/pref_eq_app"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:layout="@layout/pref_category"
        app:title="@string/pref_cat_download">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_wifi"
            app:key="wifi_only"
            app:summary="@string/pref_wifi_only_summary"
            app:title="@string/pref_wifi_only"/>
        <ListPreference
            app:defaultValue="mp3"
            app:entries="@array/format_entries"
            app:entryValues="@array/format_values"
            app:icon="@drawable/ic_music_note"
            app:key="audio_format"
            app:title="@string/pref_format"
            app:useSimpleSummaryProvider="true"/>
        <Preference
            app:icon="@drawable/ic_update"
            app:key="update_ytdlp"
            app:title="@string/pref_update"/>
    </PreferenceCategory>
    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:layout="@layout/pref_category"
        app:title="@string/pref_cat_about">
        <Preference
            app:iconSpaceReserved="false"
            app:key="version"
            app:selectable="false"
            app:title="@string/pref_version"/>
    </PreferenceCategory>
</PreferenceScreen>
